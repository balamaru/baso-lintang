  "narrative": {
    "northStar": "The Penutur's Open Dictionary",
    "overview": "A calm, night-sky reading space lets people search first and contribute without an account. The dark blue field gives long-form Indonesian text a steady home; warm yellow marks the main action, while teal is reserved for verified status. This visual system supports community review without presenting unreviewed submissions as established knowledge.",
    "keyCharacteristics": [
      "Search and contribution remain prominent at phone widths.",
      "A locally hosted display and body face give headings character while keeping paragraphs easy to read.",
      "Verification is identified with restrained teal labels.",
      "Decorative stars are limited to the hero; the remaining surfaces are flat and quiet."
    ],
    "rules": [
      {
        "name": "The Public-State Rule",
        "body": "A verified tag belongs only to published entries; pending submissions stay in the review workflow.",
        "section": "overview"
      },
      {
        "name": "The Status Color Rule",
        "body": "Teal denotes verification; yellow denotes an action or focus.",
        "section": "colors"
      },
      {
        "name": "The Two-Voice Rule",
        "body": "Use the display face for headings and the body face for instructions, labels, and definitions.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal contrast and borders to separate content; do not add decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the search and send-word actions easy to find at phone widths.",
      "Do use teal only for verified status and yellow for actions or focus.",
      "Do preserve the flat blue surfaces and readable local font pairing."
    ],
    "donts": [
      "Don't style pending submissions as verified dictionary entries.",
      "Don't add decorative shadows or external font and analytics services.",
      "Don't fill the dictionary with illustrative language presented as real Lintang vocabulary."
    ]
  }
